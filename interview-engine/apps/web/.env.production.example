# Production env for the candidate site (apps/web) on Vercel → interviehire.com
# Set these in the Vercel project's Environment Variables (Production scope).

# The hosted Fastify engine on Render (sessions + transcript + report + WS).
NEXT_PUBLIC_API_URL=https://interviehire-engine.onrender.com
NEXT_PUBLIC_WS_URL=wss://interviehire-engine.onrender.com/ws

# Vapi browser credentials for per-job conversational interviews. The public
# key is browser-safe; configure the webhook secret only on the engine service.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# The interview room uses its built-in animated AI orb. No avatar URL, GPU
# streamer, Cloudflare tunnel, or additional environment variable is required.
