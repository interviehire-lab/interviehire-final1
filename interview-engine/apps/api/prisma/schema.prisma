generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  CONSULTING
  PRODUCT_MANAGEMENT
  BUSINESS_ANALYST
  FOUNDERS_OFFICE
  GENERAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  // Transient claim marker: the evaluation poller (app/jobs/evaluation-poller.ts)
  // flips COMPLETED -> EVALUATING atomically before starting the slow LLM work,
  // so two poll ticks (or instances) can't double-process the same session.
  EVALUATING
  EVALUATED
  CANCELLED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Company {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  description  String?
  logoUrl      String?
  primaryColor String             @default("#0f766e")
  settings     Json               @default("{}")
  webhooks     Json               @default("{}")
  reportEmail  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  jobRoles     JobRole[]
  candidates   Candidate[]
  questions    Question[]
  sessions     InterviewSession[]
}

model Candidate {
  id           String             @id @default(cuid())
  companyId    String
  fullName     String
  email        String
  phone        String?
  resumeText   String?
  parsedResume Json               @default("{}")
  atsScore     Float              @default(0)
  atsBreakdown Json               @default("{}")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions     InterviewSession[]

  @@unique([companyId, email])
}

model JobRole {
  id                 String             @id @default(cuid())
  companyId          String
  title              String
  roleType           RoleType           @default(GENERAL)
  description        String
  requirements       String
  primaryCriteria    String[]
  secondaryCriteria  String[]
  atsScoringWeights  Json
  evaluationCriteria Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questions          Question[]
  sessions           InterviewSession[]
}

model Question {
  id                   String   @id @default(cuid())
  companyId            String
  jobRoleId            String?
  text                 String
  roleApplicability    RoleType[]
  difficulty           Difficulty @default(MEDIUM)
  topicCategories      String[]
  estimatedMinutes     Int        @default(4)
  aiEvaluationGuidance String
  effectivenessRating  Float      @default(0)
  version              Int        @default(1)
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  company              Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobRole              JobRole?   @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
}

model InterviewSession {
  id             String         @id @default(cuid())
  companyId      String
  candidateId    String
  jobRoleId      String
  status         SessionStatus  @default(SCHEDULED)
  websocketId    String?
  ueSocketId     String?
  startedAt      DateTime?
  completedAt    DateTime?
  scheduledAt    DateTime?
  transcript     Json           @default("[]")
  avatarProvider String         @default("ue5_pixel_streaming")
  evaluation     Json?
  reportUrl      String?
  recordingDriveFileId String?
  recordingDriveUrl    String?
  inviteToken    String?
  settings       Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate      Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobRole        JobRole        @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  proctoringLogs ProctoringLog[]
  transcriptEvents TranscriptEvent[]
  transcriptMeta   InterviewTranscript?
}

// Append-only event log for the live interview transcript. Every utterance
// fragment (candidate or interviewer, from any source) is written here as it
// happens, so a transcript survives network blips, partial STT and an interview
// that ends unexpectedly. The finalizer reads these to build the .txt file.
model TranscriptEvent {
  id          String           @id @default(cuid())
  sessionId   String
  speaker     String           // 'candidate' | 'interviewer'
  text        String
  timestampMs Int              // milliseconds relative to interview start
  source      String           // 'convai' | 'browser_stt' | 'whisper' | 'manual'
  isFinal     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestampMs])
}

// One row per session: metadata about the finalized .txt transcript.
model InterviewTranscript {
  id                 String           @id @default(cuid())
  sessionId          String           @unique
  candidateId        String?
  interviewId        String?          // maps to the job role / blueprint id
  transcriptFilePath String?
  startedAt          DateTime?
  endedAt            DateTime?
  status             String           @default("recording") // recording | finalized | empty | failed
  eventCount         Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  session            InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ProctoringLog {
  id         String            @id @default(cuid())
  sessionId  String
  eventType  String
  severity   Severity
  metadata   Json              @default("{}")
  occurredAt DateTime          @default(now())
  createdAt  DateTime          @default(now())
  session    InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, severity])
}

// Immutable audit trail ("security log") of candidate consent decisions:
// informed consent to a recorded, AI-evaluated interview, explicit biometric
// consent (face/gaze/voice), 18+ attestation, and privacy-policy + cookies
// acknowledgment. Written from the candidate room BEFORE any capture starts,
// and complements the client-side localStorage proof. Deliberately NOT related
// to InterviewSession with a cascade: a consent/security log must survive
// deletion of the interview data (security logs are retained longer than the
// interview itself), so sessionId is a plain indexed string, not a FK.
model ConsentLog {
  id             String   @id @default(cuid())
  sessionId      String
  action         String   // 'granted' | 'declined'
  consentVersion String
  scopes         Json     @default("{}") // { age18Plus, dataProcessing, biometric, privacyPolicy, cookies }
  candidateEmail String?
  candidateName  String?
  inviteToken    String?
  userAgent      String?
  ipAddress      String?
  locale         String?
  // DSAR tombstone: set to the data_subject_requests.id when this row's identifiers were
  // anonymised by an erasure (row KEPT as proof of consent, PII stripped). DPDP Act 2023.
  erasedForRequestId String?
  createdAt      DateTime @default(now())

  @@index([sessionId, createdAt])
}
