# LiveKit Cloud project credentials. The worker connects outbound to LiveKit.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=interviehire-interviewer

# Bring-your-own provider credentials. These stay on the worker.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_MODEL=sonic-3

# Private Fastify engine address and matching service-to-service secret.
ENGINE_INTERNAL_URL=http://interview-api:4000
INTERNAL_SERVICE_SECRET=

# Recruiters may choose a shorter duration, but this worker never permits more
# than 1,800 seconds. Closing begins before the hard disconnect deadline.
INTERVIEW_HARD_LIMIT_SECONDS=1800
INTERVIEW_CLOSING_RESERVE_SECONDS=45
ENGINE_REQUEST_TIMEOUT_MS=10000
PORT=8081
LOG_LEVEL=info
