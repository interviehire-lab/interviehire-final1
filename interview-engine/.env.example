# interviehire-final — AI interview engine (Fastify, port 4000)
# Shared Supabase DB (the SAME instance the backend uses). Ask the project
# owner for the connection string. Prisma tables are already provisioned there.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
PORT=4000

# Candidate web app (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# DeepSeek — powers the Aviral-engine LLM evaluation. WITHOUT a key the engine
# falls back to a deterministic evaluator (the interview still runs and scores).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_EVALUATION_MAX_TOKENS=12000

# Server-side interview transcription — candidate microphone audio and the
# avatar/interviewer tab audio are uploaded in short WebM segments. Deepgram is
# preferred; OpenAI Whisper is the fallback. Without either key, candidate audio
# automatically falls back to browser STT and interviewer audio is unavailable.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
OPENAI_API_KEY=
OPENAI_ASR_MODEL=whisper-1

# Real-time conversational interviews (LiveKit + Deepgram + Cartesia). The
# candidate browser receives only a short-lived room token minted by the
# engine; API key/secret and provider keys stay server-side. LIVEKIT_AGENT_NAME
# must match the Railway voice worker's registration (interview-engine/apps/voice-agent).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=interviehire-interviewer
INTERNAL_SERVICE_SECRET=

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Optional
# GEMINI_API_KEY=     # AI-authorship fallback
# SMTP_HOST=          # emailed PDF reports
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# REPORT_FROM=
