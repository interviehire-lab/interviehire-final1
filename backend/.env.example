# ─────────────────────────────────────────────────────
# Shared Supabase database (ask project owner for URL)
# ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# App config
SECRET_KEY=change-this-in-production
APP_NAME=Hiring Dashboard

# CORS configuration (recruiter dashboard origin)
FRONTEND_URL=http://localhost:3000

# Candidate interview room (engine web app). The emailed calendar-invite link
# opens this — the same room as "Run test interview". Prod: the root domain URL
# (e.g. https://interviehire.com) if using subroute proxied routing.
INTERVIEW_ROOM_URL=http://localhost:3001

# Email for calendar invites. Gmail SMTP is free: Google Account → Security →
# App passwords → use that as SMTP_PASSWORD. Empty = simulation mode (logs only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=interviehire@gmail.com

# Cross-site auth cookie (set in production: none / true)
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# API Keys (ask project owner for key)
DEEPSEEK_API_KEY=

# Optional API Keys
# GROQ_API_KEY=
# GROK_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=

# Optional: raises GitHub Search API rate limit (Talent Finder web source) to 5000/hr.
# Works without it at GitHub anonymous rate. Create at github.com/settings/tokens (no scopes needed).
GITHUB_TOKEN=

# Web Search source (Talent Finder, non-tech roles) — free official Brave Search API.
# Get a free key at https://brave.com/search/api (2000 queries/mo). Public results only.
BRAVE_API_KEY=

# Web Search source (Talent Finder, any role) — pick ONE free provider:
#  Google Programmable Search (free 100/day): GOOGLE_CSE_KEY + GOOGLE_CSE_ID (cse.google.com)
#  Self-hosted SearXNG (free, unlimited): SEARXNG_URL=http://localhost:8080  (docker run -d -p 8080:8080 searxng/searxng)
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
SEARXNG_URL=

# Twilio — WhatsApp interview-slot confirmation/reminder + a robocall reminder
# 30 min before the interview. Blank = the whole feature no-ops (nothing sent).
# Get credentials from the Twilio Console (console.twilio.com). A Trial account
# only reaches numbers you've manually verified there, and adds a "trial
# account" disclaimer to calls/messages — upgrade before using with real
# candidates. TWILIO_WHATSAPP_FROM/TWILIO_VOICE_FROM are bare E.164 numbers
# (e.g. +14155238886) — the `whatsapp:` prefix is added in code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=
# Optional: a scoped API Key (Console -> Account -> API keys & tokens, SID starts
# "SK...") is preferred over TWILIO_AUTH_TOKEN above when both are set — Twilio's
# recommended credential for server-side integrations (independently revocable).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# WhatsApp Business API requires a pre-approved Content Template (not freeform
# text) to message a candidate outside an open 24h session — create these in
# the Twilio Console → Content Editor and paste their Content SIDs ("HX...")
# below. Blank falls back to freeform text (only reliable on a Sandbox number).
TWILIO_WHATSAPP_CONFIRMATION_CONTENT_SID=
TWILIO_WHATSAPP_REMINDER_CONTENT_SID=

# How long before the scheduled start time the reminder (email + WhatsApp +
# robocall) fires, and the max candidates processed per reminder-job run.
REMINDER_MINUTES_BEFORE=30
REMINDER_MAX_PER_RUN=200
